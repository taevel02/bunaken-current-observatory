{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunaken-current-observatory.example/schemas/seal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_date_wita",
    "cutoff_at",
    "status",
    "run_id",
    "storage_commit",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target_date_wita": {
      "type": "string",
      "format": "date"
    },
    "cutoff_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "sealed",
        "missed_d1_snapshot"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "storage_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "manifest_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
