{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunaken-current-observatory.example/schemas/latest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "release_id": {
      "type": "string",
      "format": "uuid"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
