{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bunaken-current-observatory.example/schemas/snapshot-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "status",
    "manifest_path",
    "manifest_sha256",
    "storage_commit",
    "persisted_at",
    "valid_start",
    "valid_end"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "enum": [
        "snapshot",
        "backfill"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "manifest_path": {
      "type": "string",
      "pattern": "^(snapshots|backfills)/[0-9-]+/[0-9a-f-]+/manifest[.]json$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "persisted_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_start": {
      "type": "string",
      "format": "date-time"
    },
    "valid_end": {
      "type": "string",
      "format": "date-time"
    }
  }
}
