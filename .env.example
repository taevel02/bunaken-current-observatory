# Server-only values. Never prefix these with NEXT_PUBLIC_.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_ENABLED=false
ADMIN_AUTH_VERSION=
PUBLIC_OBSERVER_ID=
# Generate 32 random bytes: node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64url"))'
SESSION_SECRET=
# Separate 32-byte base64url HMAC key. Never reuse SESSION_SECRET.
IDEMPOTENCY_SECRET=
GITHUB_WRITE_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DATA_BRANCH=data
CANONICAL_ORIGIN=http://localhost:3000

# Collection runner only; never expose these to NEXT_PUBLIC_ or untrusted previews.
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# Private local atlas config; do not commit atlas/config files containing private paths.
AVISO_USERNAME=
AVISO_PASSWORD=
FES_CONFIG_PATH=
# Set cm or m only after verifying the actual atlas amplitude units.
FES_ATLAS_UNIT=
# Explicit noncommercial or commercial; commercial requires customer API credentials.
OPEN_METEO_USAGE_MODE=
OPEN_METEO_API_KEY=
